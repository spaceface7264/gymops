# Copy to .env.local and fill in. VITE_ vars are shipped to the browser;
# never put secrets (service role key, Anthropic key, Resend key) here — those
# live in Supabase secrets and GitHub Actions secrets (spec §5).

# Local stack: run `npm run db:start` and copy the values it prints.
# The URL is stable; the publishable key is printed as "publishable key".
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Hosted project (staging/prod builds):
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Web push (P5-05). The public half of the VAPID pair the notify function signs
# with — generate one with `npx web-push generate-vapid-keys` and keep the
# private half in Supabase secrets, never here. Leave it empty and the push
# opt-in says push is not set up rather than failing when it is pressed.
VITE_VAPID_PUBLIC_KEY=
